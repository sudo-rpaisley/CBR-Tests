          "traffic_group",
          "attack_type",
          "Label"
        ]
      },
      "calculation": {
        "method": "tabular_slice_identifier_consistency",
        "parameters": {
          "rules": [
            {
              "when_field": "source_file",
              "operator": "contains",
              "value": "slice1",
              "expected_slice_ids": [
                "slice1"
              ]
            },
            {
              "when_field": "source_file",
              "operator": "contains",
              "value": "slice2",
              "expected_slice_ids": [
                "slice2"
              ]
            }
          ],
          "case_sensitive": false,
          "missing_policy": "count_invalid",
          "max_examples": 10
        }
      },
      "retention": {
        "store_raw_output": true,
        "store_summary": true,
